# ─────────────────────────────────────────────────
#  Aura AI — Environment Variables
#  Copy this file to .env.local and fill in values
# ─────────────────────────────────────────────────

# ── Firebase Client (public, used in browser) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server-side only) ──
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Twilio ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_PHONE_NUMBER=

# ── Groq (LLM + Whisper STT) ──
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_WHISPER_FALLBACK_MODEL=whisper-large-v3

# ── Deepgram (Voice Preview) ──
DEEPGRAM_API_KEY=

# ── Google Speech-to-Text ──
GOOGLE_STT_API_KEY=

# ── Pinecone (RAG Vector Store) ──
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_HOST=

# ── Transcription Engine ──
TRANSCRIPTION_MODEL=GROQ                 # GROQ | GOOGLE
STT_LANGUAGE_CODE=en-IN
STT_CHUNK_SECONDS=1.8
# STT_CHUNK_SECONDS_GOOGLE=2.0
STT_CHUNK_SECONDS_GROQ=4.5
STT_CHUNK_SECONDS_GROQ_AGENT=2.0
RMS_SILENCE_THRESHOLD_GROQ_CUSTOMER=500
RMS_SILENCE_THRESHOLD_GROQ_AGENT=220
TWILIO_INBOUND_SPEAKER=agent
TWILIO_OUTBOUND_SPEAKER=customer
STT_MAX_RETRIES=0
STT_RETRY_DELAY_SECONDS=0.25
GROQ_HTTP_TIMEOUT_SECONDS=6.0
GOOGLE_HTTP_TIMEOUT_SECONDS=8.0
INTEL_HTTP_TIMEOUT_SECONDS=6.0
FIRESTORE_RETRY_ATTEMPTS=2
FIRESTORE_RETRY_DELAY_SECONDS=0.4
ENABLE_LOCAL_INTELLIGENCE_FALLBACK=false

# ── Tunneling (for local dev with Twilio) ──
NGROK_URL=
WEBSOCKET_TUNNEL_URL=

# ── Hybrid Endpoint (defaults to localhost in dev) ──
HYBRID_ENDPOINT_URL=http://localhost:3000/api/transcription/hybrid

# ── Next.js Dev Origins (comma-separated cloudflare domains) ──
ALLOWED_DEV_ORIGINS=
